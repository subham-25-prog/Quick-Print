{
  "name": "quickprint",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "web"
  ],
  "dependencies": {
    "next": "16.4.0"
  },
  "overrides": {
    "postcss": "8.5.28",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  },
  "scripts": {
    "build": "cd web && npm run build",
    "dev": "cd web && npm run dev",
    "start": "cd web && npm run start",
    "lint": "npm run lint --workspace web",
    "typecheck": "npm run typecheck --workspace web"
  }
}
