# QuickPrint web — one deployment and Supabase project per shop.
# Copy to web/.env.local for local work; put production values in Vercel.
# Never commit filled files. Generate unique secrets with scripts/new-shop.mjs.
QUICKPRINT_SHOP_ID=
NEXT_PUBLIC_APP_URL=https://your-stable-shop-domain.example
NEXT_PUBLIC_SHOP_NAME=QuickPrint
NEXT_PUBLIC_SHOP_TAGLINE=Self-Service Document Printing
NEXT_PUBLIC_SHOP_ADDRESS=
NEXT_PUBLIC_SHOP_PHONE=
# Optional local/public HTTPS branding image; no secrets here.
NEXT_PUBLIC_SHOP_LOGO_URL=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# No browser Supabase key is required by the current API-only checkout.
ADMIN_PIN=
ADMIN_SESSION_SECRET=
ORDER_ACCESS_SECRET=
PRINT_AGENT_ID=counter-01
PRINT_AGENT_SECRET=
CRON_SECRET=
DOCUMENT_RETENTION_DAYS=3
# Cashfree credentials remain server-only. Unknown providers fail closed.
PAYMENT_PROVIDER=cashfree
PAYMENT_ENVIRONMENT=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Cashfree PG API version. Keep this aligned with the dashboard integration.
CASHFREE_API_VERSION=2025-01-01
PHONEPE_MERCHANT_ID=
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_VERSION=
PHONEPE_CLIENT_SECRET=
# Select SHA username/password authentication in PhonePe webhook settings.
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=
