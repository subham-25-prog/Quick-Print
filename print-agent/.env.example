# ==============================================================================
# QuickPrint Windows Print Agent Configuration
# Installed on the shop's local Windows PC connected to physical printers
# ==============================================================================

# URL of this shop's deployed QuickPrint web application
BACKEND_URL=http://localhost:3000

# Secret matching PRINT_AGENT_SECRET configured in web/.env
PRINT_AGENT_SECRET=qp_sec_live_98a72b1c4e5f603d

# Unique Agent ID for this counter PC
AGENT_ID=counter-pc-01

# Printer Name (exact Windows printer name as shown in Control Panel / Printers)
# Leave empty or omit to use the Windows Default Printer
PRINTER_NAME=

# Polling Interval (in milliseconds)
POLL_INTERVAL_MS=3000

# Heartbeat Interval (in milliseconds)
HEARTBEAT_INTERVAL_MS=15000

# Local folder for temporary document downloads
DOWNLOAD_DIR=./temp_jobs

# Set to true to test/simulate printing without wasting paper
SIMULATE_PRINT=false
