# Copy to .env in this directory. Do not reuse another shop's credentials.
BACKEND_URL=https://your-stable-shop-domain.example
AGENT_ID=counter-01
PRINT_AGENT_SECRET=
# Sandbox can only simulate; live requires a real printer.
AGENT_MODE=sandbox
SIMULATE_PRINT=true
PRINTER_NAME=
# Optional startup preference. Leave blank to discover the Windows default or
# first available physical printer; dashboard selections take precedence.
POLL_INTERVAL_MS=5000
HEARTBEAT_INTERVAL_MS=15000
DOWNLOAD_DIR=./temp_jobs
# Preserve this directory across restarts/upgrades. Never clear it to retry.
STATE_DIR=./state
